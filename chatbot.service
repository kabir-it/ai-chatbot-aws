[Unit]
Description=AI chatbot
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/chatbot
Environment=AWS_REGION=eu-north-1
# Use the exact inference profile ID from the Bedrock console (Cross-region inference)
Environment=BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
Environment=TIMEZONE=Europe/Stockholm
ExecStart=/home/ubuntu/chatbot/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 90 app:app
Restart=always

[Install]
WantedBy=multi-user.target
